{
  "name": "github-pages",
  "description": "GitHub Action to deploy to GitHub Pages",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs --sourcemap --minify && yarn run license",
    "lint": "eslint --max-warnings=0 .",
    "format": "eslint --fix .",
    "license": "generate-license-file --input package.json --output dist/licenses.txt --overwrite --ci --no-spinner --eol lf",
    "all": "yarn run build && yarn run format"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crazy-max/ghaction-github-pages.git"
  },
  "keywords": [
    "actions",
    "github",
    "pages",
    "deploy"
  ],
  "author": "CrazyMax",
  "license": "MIT",
  "packageManager": "yarn@4.17.0",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "addressparser": "^1.0.1",
    "fs-extra": "^11.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/addressparser": "^1.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "generate-license-file": "^4.1.1",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  }
}
